rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read/write access to medicines, dispense_records, and sessions
    // to support simulated Arabic roles and custom user-defined therapeutic categories/units.
    match /medicines/{medicineId} {
      allow read, write: if true;
    }
    match /dispense_records/{recordId} {
      allow read, write: if true;
    }
    match /user_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /stock_audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
